<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>SwiftyGrok</string>
    <key>CFBundleDisplayName</key><string>SwiftyGrok</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>ru</string><string>en</string></array>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.5.2</string>
    <key>CFBundleVersion</key><string>96</string>
    <key>NSCameraUsageDescription</key><string>Take a photo to attach to your Grok message.</string>
    <key>NSMicrophoneUsageDescription</key><string>Record your voice and send it to Grok to turn it into message text.</string>
    <key>CFBundleURLTypes</key><array><dict>
        <key>CFBundleURLName</key><string>app.swiftygrok.widgets</string>
        <key>CFBundleURLSchemes</key><array><string>swiftygrok</string></array>
    </dict></array>
    <key>CFBundleIconName</key><string>AppIcon</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Chat attachments</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>None</string>
            <key>LSItemContentTypes</key><array><string>public.data</string></array>
        </dict>
    </array>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 SwiftyGrok contributors.</string>
</dict>
</plist>
